{
  "firestore": {
    "database": "default",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ],
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "sukhmaldryfruits.com",
      "www.sukhmaldryfruits.com",
