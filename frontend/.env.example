# Server-only Gemini keys (Netlify functions / local CRA proxy). Never prefix REACT_APP_ or NEXT_PUBLIC_.
# Local: put both in frontend/.env and restart `npm start`.
# Live: Netlify → Site configuration → Environment variables → Production (and Preview).
# Either GEMINI_ASSISTANT_API_KEY or GEMINI_API_KEY is enough for chat/inventory.
# GEMINI_IMAGE_API_KEY is used only for hamper image generation (falls back to the keys above).
# Change GEMINI_MODEL when Google retires a model — no code edit needed.
GEMINI_API_KEY=
GEMINI_ASSISTANT_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Vertex AI image generation (hamper photos). Uses Cloud billing on project sukhmal.
# Local: `gcloud auth login --project=sukhmal` then restart `npm start`.
# Live: set GOOGLE_APPLICATION_CREDENTIALS_JSON to a service-account JSON string.
# Do not send a Gemini AI Studio API key to Vertex — those keys are blocked for aiplatform.
GOOGLE_CLOUD_PROJECT=sukhmal
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Server-only. Never prefix REACT_APP_ — that would leak it to the browser.
RESEND_API_KEY=
RESEND_FROM=Sukhmal Dry Fruits <onboarding@resend.dev>
