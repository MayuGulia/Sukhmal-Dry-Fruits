# Leave empty to run the shop from the built-in catalog (static deploy).
REACT_APP_BACKEND_URL=

# Public Firebase web config (safe). Security is in Firestore rules + custom claims.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Server-only Gemini keys (Netlify functions / setupProxy). Do not prefix REACT_APP_.
# Change GEMINI_MODEL when Google retires a model — no code edit needed.
GEMINI_API_KEY=
GEMINI_ASSISTANT_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Public Razorpay key only. Secret stays on the server.
REACT_APP_RAZORPAY_KEY_ID=
REACT_APP_WHATSAPP_NUMBER=919876543210
REACT_APP_ADMIN_EMAIL=monikabatra890@gmail.com
