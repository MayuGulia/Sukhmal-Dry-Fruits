# Server-only Gemini keys. Never prefix REACT_APP_ or NEXT_PUBLIC_.
# Local: put both in frontend/.env and restart `npm start`.
# Live Firebase HTTP functions: `firebase functions:secrets:set` on sukhmal-website
#   (GEMINI_API_KEY, GEMINI_ASSISTANT_API_KEY, GEMINI_IMAGE_API_KEY).
# Either GEMINI_ASSISTANT_API_KEY or GEMINI_API_KEY is enough for chat/inventory.
# GEMINI_IMAGE_API_KEY is used for hamper preview photos via Google AI Studio
# (generativelanguage.googleapis.com) — not Vertex. Falls back to the keys above.
# Change GEMINI_MODEL when Google retires a model — no code edit needed.
GEMINI_API_KEY=
GEMINI_ASSISTANT_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Vertex AI (GCP billing / gcloud ADC) is required for admin inventory commands.
# Hamper photos also use Vertex on billed project sukhmal-website.
# Do not send a Gemini AI Studio API key to Vertex — those keys are blocked for aiplatform.
GOOGLE_CLOUD_PROJECT=sukhmal-website
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# LOCAL DEV ONLY — never set this on Firebase production.
# When true (and NODE_ENV=development), hamper preview skips Gemini.
# HAMPER_IMAGE_DEMO_MODE=true

# Server-only. Never prefix REACT_APP_ — that would leak it to the browser.
RESEND_API_KEY=
RESEND_FROM=Sukhmal Dry Fruits <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=sukhmaldryfruitskorner2@gmail.com

# Server-only CallMeBot WhatsApp (owner new-order ping). Never prefix REACT_APP_.
# Live: `firebase functions:secrets:set WHATSAPP_OWNER_PHONE` and
# `firebase functions:secrets:set CALLMEBOT_API_KEY` on sukhmal-website.
# Local: set both here and restart `npm start`.
# Digits only, country code, no + (example India: 91XXXXXXXXXX).
WHATSAPP_OWNER_PHONE=
CALLMEBOT_API_KEY=

# Public Razorpay key only. Secret stays on the server.
REACT_APP_RAZORPAY_KEY_ID=
REACT_APP_WHATSAPP_NUMBER=918595321912
