# Leave empty so checkout APIs (/api/create-order) stay relative to this origin.
# Production Firebase Hosting rewrites /api/* to firebase/http-functions.
# Local CRA still proxies /api via setupProxy. Do not point this at a Netlify URL.
REACT_APP_BACKEND_URL=

