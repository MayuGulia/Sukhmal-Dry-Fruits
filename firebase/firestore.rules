rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'sukhmaldryfruitskorner2@gmail.com'
      );
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '');
    }
    function isStaff() {
      return isAdmin() || (isSignedIn() && userRole() in ['admin', 'manager', 'staff']);
    }
    function isActiveProduct() {
      return resource.data.get('isActive', true) != false
        && resource.data.get('isDeleted', false) != true;
    }

    match /products/{id} {
      allow read: if isActiveProduct() || isStaff();
      allow write: if isAdmin();
    }
    match /hampers/{id} {
      allow read: if resource.data.get('isActive', true) != false || isStaff();
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow get: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.paymentStatus == 'pending';
      allow update: if isStaff() || (
        isSignedIn()
        && request.auth.uid == resource.data.userId
        && resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('orderStatus', '') == resource.data.get('orderStatus', '')
        && request.resource.data.get('status', resource.data.get('status', '')) == resource.data.get('status', '')
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'orderStatus', 'trackingNumber', 'courierName', 'estimatedDeliveryDate', 'shippedNotifyAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['razorpayOrderId', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSignedIn() && isOwner(uid)
        && !request.resource.data.keys().hasAny(['admin', 'isAdmin', 'customClaims'])
        && request.resource.data.get('role', 'customer') == 'customer'
        && request.resource.data.get('loyaltyPoints', 0) == 0;
      allow update: if isAdmin() || (
        isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'loyaltyPoints', 'admin', 'isAdmin', 'customClaims'])
      );
      allow delete: if false;
    }

    match /coupons/{code} {
      allow read: if resource.data.get('isActive', true) == true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /bulkInquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          'type', 'companyName', 'name', 'contact', 'phone', 'email',
          'quantity', 'occasion', 'notes', 'budget', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('companyName', '') is string
        && request.resource.data.get('companyName', '').size() <= 120
        && request.resource.data.get('contact', '') is string
        && request.resource.data.get('contact', '').size() <= 80
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 500
        && request.resource.data.get('quantity', '') is string
        && request.resource.data.get('quantity', '').size() <= 40
        && request.resource.data.get('occasion', '') is string
        && request.resource.data.get('occasion', '').size() <= 80
        && request.resource.data.get('budget', '') is string
        && request.resource.data.get('budget', '').size() <= 40;
      allow read, update: if isStaff();
      allow delete: if false;
    }

    match /feedback/{id} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 8
        && request.resource.data.text.size() <= 600
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.get('published', false) == false;
      allow update, delete: if isAdmin();
    }

    match /newsletter/{id} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow update: if request.resource.data.email == resource.data.email;
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /hamperBuilds/{id} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /aiPreviews/{id} {
      allow read, write: if false;
    }
    match /imageCache/{id} {
      allow read, write: if false;
    }
    match /chatSessions/{id} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /analytics_events/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'event_type', 'session_id', 'user_id', 'product_id', 'page',
          'timestamp', 'day', 'metadata', 'returning'
        ])
        && request.resource.data.event_type in [
          'page_view', 'product_view', 'add_to_cart', 'wishlist_add',
          'checkout_started', 'order_placed', 'hamper_builder_started', 'ai_widget_used'
        ]
        && request.resource.data.session_id is string
        && request.resource.data.session_id.size() >= 8
        && request.resource.data.session_id.size() <= 80
        && request.resource.data.page is string
        && request.resource.data.page.size() < 200
        && request.resource.data.timestamp == request.time;
      allow read: if isStaff();
      allow update, delete: if false;
    }
    match /analytics_daily/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /analytics_monthly/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
