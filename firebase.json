{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ],
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Sukhmal Dry Fruits Korner",
        "supportEmail": "sukhmaldryfruitskorner2@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://sukhmal-website.firebaseapp.com"
        ]
      }
    }
  }
}
