# Server-only Gemini keys. Never prefix REACT_APP_ or NEXT_PUBLIC_.
# Local: put both in frontend/.env and restart `npm start`.
# Live Netlify: Site configuration → Environment variables.
# Live Firebase HTTP functions: Secret Manager on the functions project
#   (GEMINI_API_KEY, GEMINI_ASSISTANT_API_KEY, GEMINI_IMAGE_API_KEY).
# Either GEMINI_ASSISTANT_API_KEY or GEMINI_API_KEY is enough for chat/inventory.
# GEMINI_IMAGE_API_KEY is used for hamper preview photos via Google AI Studio
# (generativelanguage.googleapis.com) — not Vertex. Falls back to the keys above.
# Change GEMINI_MODEL when Google retires a model — no code edit needed.
GEMINI_API_KEY=
GEMINI_ASSISTANT_API_KEY=
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Vertex AI is optional for chat/inventory text. Hamper photos use GEMINI_IMAGE_API_KEY
# against Google AI Studio, not aiplatform / Vertex.
# Do not send a Gemini AI Studio API key to Vertex — those keys are blocked for aiplatform.
GOOGLE_CLOUD_PROJECT=sukhmal-website
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# LOCAL DEV ONLY — never set this on Netlify production / Cloud Run.
# When true (and NODE_ENV=development or NETLIFY_DEV), hamper preview skips Gemini.
# HAMPER_IMAGE_DEMO_MODE=true

# Server-only. Never prefix REACT_APP_ — that would leak it to the browser.
