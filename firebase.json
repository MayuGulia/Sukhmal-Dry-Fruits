      "sukhmal.web.app"
    ],
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Sukhmal Dry Fruits Korner",
        "supportEmail": "mayu.gulia156@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "http://127.0.0.1",
          "https://localhost",
          "https://127.0.0.1",
          "https://sukhmaldryfruits.com",
          "https://www.sukhmaldryfruits.com",
