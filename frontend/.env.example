# Local Admin SDK. Drop the new JSON at firebase/serviceAccountKey.json — do not commit it.
# GOOGLE_APPLICATION_CREDENTIALS=../firebase/serviceAccountKey.json
# FIREBASE_ADMIN_CLIENT_EMAIL=
